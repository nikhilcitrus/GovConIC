{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "paragraphCount": 4,
  "h2Count": 2,
  "statCount": 1,
  "pullquoteCount": 1,
  "calloutCount": 1,
  "paragraphWordMin": 20,
  "paragraphWordMax": 50,
  "totalWordMin": 100,
  "totalWordMax": 200,
  "wordCountTolerance": 0,
  "subtitleWordMin": 30,
  "subtitleWordMax": 40,
  "cmmcTerms": [
    "CMMC",
    "C3PAO",
    "POA&M",
    "SSP",
    "NIST SP 800-171",
    "NIST SP 800-172",
    "scoring methodology",
    "Level 1",
    "Level 2",
    "Level 3",
    "assessment",
    "certification",
    "compliance",
    "CUI",
    "Controlled Unclassified Information",
    "Defense Industrial Base",
    "Cyber AB",
    "scoping guide"
  ],
  "prohibitedPatterns": [
    "press release",
    "partnership announcement",
    "series a",
    "series b",
    "funding round",
    "raises $",
    "announces partnership",
    "proud to announce",
    "top 10",
    "game-changer",
    "revolutionary",
    "disrupting government",
    "according to a recent report",
    "in a recent announcement",
    "sources say",
    "experts agree",
    "industry leaders say"
  ],
  "companionAssets": {
    "minAltTitles": 5,
    "minLinkedinPostChars": 50,
    "minNewsletterSummaryChars": 30,
    "minDiagrams": 1,
    "minFollowOnIdeas": 5
  },
  "duplicateHeadlineOverlapWords": 6,
  "cacheLimits": {
    "recentHeadlines": 15,
    "pendingFollowOnTopics": 30,
    "duplicateHistory": 300
  }
}
