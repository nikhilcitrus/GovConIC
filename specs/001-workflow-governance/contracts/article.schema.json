{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://govconic.internal/schemas/article.schema.json",
  "title": "Article",
  "description": "Canonical normalized article object produced by article-response-normalizer. See specs/001-workflow-governance/data-model.md#article.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "headline",
    "slug",
    "section",
    "kicker",
    "subtitle",
    "dek",
    "byline",
    "date",
    "readMinutes",
    "bodyWordCount",
    "body",
    "altTitles",
    "linkedinPost",
    "newsletterSummary",
    "suggestedDiagrams",
    "followOnIdeas"
  ],
  "properties": {
    "headline": { "type": "string", "minLength": 5 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "section": { "type": "string", "minLength": 1 },
    "kicker": { "type": "string" },
    "subtitle": { "type": "string", "minLength": 1 },
    "dek": { "type": "string" },
    "byline": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "readMinutes": { "type": "integer", "minimum": 1 },
    "bodyWordCount": { "type": "integer", "minimum": 0 },
    "body": {
      "type": "array",
      "items": { "$ref": "#/$defs/contentBlock" },
      "minItems": 1
    },
    "altTitles": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 5
    },
    "linkedinPost": { "type": "string", "minLength": 50 },
    "newsletterSummary": { "type": "string", "minLength": 30 },
    "suggestedDiagrams": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "followOnIdeas": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 5
    }
  },
  "$defs": {
    "contentBlock": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "p" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"]
        },
        {
          "properties": {
            "type": { "const": "h2" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"]
        },
        {
          "properties": {
            "type": { "const": "h3" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"]
        },
        {
          "properties": {
            "type": { "const": "h4" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"]
        },
        {
          "properties": {
            "type": { "const": "stat" },
            "value": { "type": "string" },
            "label": { "type": "string" }
          },
          "required": ["type", "value", "label"]
        },
        {
          "properties": {
            "type": { "const": "pullquote" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"]
        },
        {
          "properties": {
            "type": { "const": "list" },
            "items": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          },
          "required": ["type", "items"]
        },
        {
          "properties": {
            "type": { "const": "callout" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"]
        }
      ]
    }
  }
}
