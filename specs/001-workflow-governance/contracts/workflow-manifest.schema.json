{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://govconic.internal/schemas/workflow-manifest.schema.json",
  "title": "Orchestration Workflow Manifest",
  "description": "Machine-readable manifest at .specify/workflows/cmmc-content-publishing/workflow.json. References skill names rather than embedding skill instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "runtime", "steps"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "runtime": { "const": "n8n" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "skill"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "skill": {
            "type": "string",
            "description": "Must correspond to a directory under .specify/skills/"
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string" }
          },
          "branch": {
            "type": "string",
            "enum": ["pass", "fail", "always"],
            "description": "Which upstream branch this step consumes, for pass/fail-gated steps such as publication."
          }
        }
      }
    }
  }
}
